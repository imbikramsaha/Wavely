<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bootstrap theme only. All real theming is done in Compose (ui/theme).
      NoActionBar + a neutral window background to avoid a launch flash.
      Day/night handled by the values-night variant + Compose.
    -->
    <style name="Theme.Wavely" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#EEF1F6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
